# Copiar a .env y completar. .env NO se sube a git (está en .gitignore).
# Versión de la imagen oficial de Superset que usa docker-compose-image-tag.yml
TAG=4.1.2
# Referencia: la clave que usa el contenedor se define en docker/.env-local
# (generar con  openssl rand -base64 42)
SUPERSET_SECRET_KEY=CAMBIAR
# Token de GitHub (solo para hacer push; no lo usa Superset)
TOKEN_GITHUB=
